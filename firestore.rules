rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil pengguna (nama + foto) dan riwayat tes.
    // Hanya pemilik akun yang boleh baca/tulis datanya sendiri.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Riwayat tes: users/{uid}/results/{id}
      match /results/{resultId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

  }
}
